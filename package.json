{
  "name": "storybook-run-all-repro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build",
    "test:protocol": "node --test test/protocol.test.mjs",
    "test:stories": "vitest run --config vitest.config.mjs",
    "repro:fix": "node scripts/toggle-fix.mjs apply",
    "repro:restore": "node scripts/toggle-fix.mjs restore"
  },
  "devDependencies": {
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/html-vite": "10.6.5",
    "@vitest/browser-playwright": "4.1.12",
    "playwright": "1.60.0",
    "storybook": "10.6.5",
    "vite": "6.4.2",
    "vitest": "4.1.12"
  }
}
